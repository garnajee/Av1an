# Use the crazymax/osxcross image for macOS cross-compilation
FROM crazymax/osxcross:latest

# Install build dependencies for av1an
# The crazymax/osxcross image is based on Debian and has the basic build tools.
# We need to install Rust, Python, VapourSynth, and nasm.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nasm \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install VapourSynth using pip
RUN pip3 install vapoursynth

# Install Rust using rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# The crazymax/osxcross image should configure the cross-compilation
# environment automatically for cargo. We just need to specify the target.

# Create a new directory for the build
WORKDIR /build

# Copy the source code into the container
COPY . .

# Build av1an for macOS
RUN cargo build --target=x86_64-apple-darwin --release

# The final binary will be at /build/target/x86_64-apple-darwin/release/av1an
